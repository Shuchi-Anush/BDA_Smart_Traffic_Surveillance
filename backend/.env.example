APP_NAME=smart-traffic-surveillance
APP_ENV=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-local-minio-user
MINIO_SECRET_KEY=replace-with-local-minio-secret
MINIO_SECURE=false
MINIO_BUCKET=traffic-data
